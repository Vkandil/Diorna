{
  "name": "diorna",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/diorna-app/diorna.git"
  },
  "packageManager": "npm@11.5.1",
  "description": "Local-first knowledge and productivity suite for Windows",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "tauri": "tauri",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test && cargo test --manifest-path src-tauri/Cargo.toml"
  },
